{
  "name": "evercode-crypto-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "Cryptocurrency price tracker with CoinMarketCap, SQLite and an authenticated REST API",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/src/server.js",
    "test": "npm run build && jest --runInBand",
    "test:coverage": "npm run build && jest --runInBand --coverage",
    "demo": "npm run build && node dist/src/demo.js",
    "check:live": "npm run build && node --env-file=.env scripts/live-check.cjs",
    "check:openapi": "node scripts/check-openapi.cjs"
  },
  "dependencies": {
    "axios": "1.20.0",
    "express": "5.3.0"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@types/supertest": "6.0.3",
    "jest": "30.5.2",
    "supertest": "7.3.1",
    "typescript": "5.9.3"
  }
}
