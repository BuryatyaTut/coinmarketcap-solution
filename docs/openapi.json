{
  "openapi": "3.0.3",
  "info": {
    "title": "Evercode Lab cryptocurrency tracker",
    "version": "1.0.0",
    "description": "Cryptocurrency price tracker. Node 24; SQLite file storage; USD only; opaque application Bearer key; locally observed history. Latest prices are stored observations with freshness metadata. See README for setup and implementation decisions."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local development server"
    }
  ],
  "security": [
    {
      "AppApiKey": []
    }
  ],
  "paths": {
    "/api/v1/cryptocurrencies": {
      "post": {
        "operationId": "createCryptocurrency",
        "summary": "Track a cryptocurrency and store its initial USD quote",
        "description": "Validate CMC identity and obtain an initial quote before atomically committing coin and observation. Unknown query fields are rejected. Maximum JSON body 16 KB. Concurrent requests for an asset already being added return 409 without another provider call.",
        "responses": {
          "201": {
            "description": "Success.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Cryptocurrency"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLarge"
          },
          "415": {
            "$ref": "#/components/responses/UnsupportedMediaType"
          },
          "422": {
            "$ref": "#/components/responses/UnknownAsset"
          },
          "502": {
            "$ref": "#/components/responses/UpstreamError"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          },
          "504": {
            "$ref": "#/components/responses/UpstreamTimeout"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCryptocurrency"
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listCryptocurrencies",
        "summary": "List tracked cryptocurrencies",
        "description": "Ordered by local ID ascending. Empty result is an empty items array.",
        "responses": {
          "200": {
            "description": "Success.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CryptocurrencyPage"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/Offset"
          }
        ]
      }
    },
    "/api/v1/cryptocurrencies/{id}": {
      "get": {
        "operationId": "getCryptocurrency",
        "summary": "Read a tracked cryptocurrency",
        "description": "",
        "responses": {
          "200": {
            "description": "Success.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Cryptocurrency"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          }
        ]
      },
      "patch": {
        "operationId": "updateCryptocurrency",
        "summary": "Rename a tracked cryptocurrency",
        "description": "Name only; trim and require a nonblank value. CMC ID and symbol cannot be changed by this request. Price history remains attached to the same asset.",
        "responses": {
          "200": {
            "description": "Success.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Cryptocurrency"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLarge"
          },
          "415": {
            "$ref": "#/components/responses/UnsupportedMediaType"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateCryptocurrency"
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteCryptocurrency",
        "summary": "Delete a tracked cryptocurrency and its price history",
        "description": "Hard deletion cascades to observations. A later request for the removed local ID returns 404.",
        "responses": {
          "204": {
            "description": "Success."
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          }
        ]
      }
    },
    "/api/v1/cryptocurrencies/{id}/price": {
      "get": {
        "operationId": "getLatestPrice",
        "summary": "Read the latest stored price",
        "description": "Does not call the provider. Returns timestamps and a stale flag. Select latest by observedAt descending, then observation ID descending. Missing asset is 404; existing asset without a quote is 503.",
        "responses": {
          "200": {
            "description": "Success.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LatestPrice"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          }
        ]
      }
    },
    "/api/v1/cryptocurrencies/{id}/history": {
      "get": {
        "operationId": "getPriceHistory",
        "summary": "Read locally collected price history",
        "description": "Observations since tracking began; no pre-tracking historical backfill. Newest first with observation ID descending as tie-breaker. Date filters use observedAt. Existing coin without matching observations returns an empty items array.",
        "responses": {
          "200": {
            "description": "Success.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HistoryPage"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          },
          {
            "$ref": "#/components/parameters/From"
          },
          {
            "$ref": "#/components/parameters/To"
          },
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/Offset"
          }
        ]
      }
    },
    "/api/v1/prices": {
      "get": {
        "operationId": "listLatestPrices",
        "summary": "Read latest stored prices for tracked cryptocurrencies",
        "description": "One item per tracked coin, local ID ascending. latestPrice is null if no observation exists. Does not call the provider.",
        "responses": {
          "200": {
            "description": "Success.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PriceSummaryPage"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/Offset"
          }
        ]
      }
    },
    "/openapi.json": {
      "get": {
        "operationId": "getOpenApi",
        "summary": "Read the OpenAPI contract",
        "description": "Authenticated endpoint returning this API contract.",
        "responses": {
          "200": {
            "description": "Success.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "The OpenAPI 3.0 document."
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "AppApiKey": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "opaque API key",
        "description": "Application API key; never the CoinMarketCap provider credential."
      }
    },
    "schemas": {
      "Cryptocurrency": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "cmcId",
          "symbol",
          "name",
          "createdAt",
          "updatedAt",
          "lastPriceAt"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "cmcId": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "symbol": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "description": "Trimmed local display name; refresh preserves it."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "lastPriceAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "PriceObservation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "cryptocurrencyId",
          "price",
          "currency",
          "observedAt",
          "sourceUpdatedAt"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "cryptocurrencyId": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "price": {
            "type": "number",
            "format": "double",
            "minimum": 0,
            "description": "Finite approximate market quote; not rounded to two decimals."
          },
          "currency": {
            "type": "string",
            "enum": [
              "USD"
            ]
          },
          "observedAt": {
            "type": "string",
            "format": "date-time"
          },
          "sourceUpdatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "LatestPrice": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "cryptocurrencyId",
          "price",
          "currency",
          "observedAt",
          "sourceUpdatedAt",
          "stale"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "cryptocurrencyId": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "price": {
            "type": "number",
            "format": "double",
            "minimum": 0,
            "description": "Finite approximate market quote; not rounded to two decimals."
          },
          "currency": {
            "type": "string",
            "enum": [
              "USD"
            ]
          },
          "observedAt": {
            "type": "string",
            "format": "date-time"
          },
          "sourceUpdatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "stale": {
            "type": "boolean",
            "description": "True when either receipt age or provider quote age exceeds the configured freshness threshold."
          }
        }
      },
      "CreateCryptocurrency": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cmcId"
        ],
        "properties": {
          "cmcId": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        }
      },
      "UpdateCryptocurrency": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "description": "Trimmed local display name; null characters are rejected; refresh preserves it.",
            "pattern": "^[^\\u0000]*$"
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message",
              "requestId"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "requestId": {
                "type": "string"
              }
            }
          }
        }
      },
      "CryptocurrencyPage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "limit",
          "offset"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Cryptocurrency"
            }
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      },
      "HistoryPage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "limit",
          "offset"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PriceObservation"
            }
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      },
      "PriceSummary": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cryptocurrency",
          "latestPrice"
        ],
        "properties": {
          "cryptocurrency": {
            "$ref": "#/components/schemas/Cryptocurrency"
          },
          "latestPrice": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "cryptocurrencyId",
              "price",
              "currency",
              "observedAt",
              "sourceUpdatedAt",
              "stale"
            ],
            "properties": {
              "id": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "cryptocurrencyId": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "price": {
                "type": "number",
                "format": "double",
                "minimum": 0,
                "description": "Finite approximate market quote; not rounded to two decimals."
              },
              "currency": {
                "type": "string",
                "enum": [
                  "USD"
                ]
              },
              "observedAt": {
                "type": "string",
                "format": "date-time"
              },
              "sourceUpdatedAt": {
                "type": "string",
                "format": "date-time"
              },
              "stale": {
                "type": "boolean",
                "description": "True when either receipt age or provider quote age exceeds the configured freshness threshold."
              }
            },
            "nullable": true
          }
        }
      },
      "PriceSummaryPage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "limit",
          "offset"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PriceSummary"
            }
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      }
    },
    "parameters": {
      "Id": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Local database record ID, distinct from CMC ID.",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "description": "Single integer value. Unknown/repeated query parameters are rejected.",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 50
        }
      },
      "Offset": {
        "name": "offset",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "default": 0
        }
      },
      "From": {
        "name": "from",
        "in": "query",
        "description": "Inclusive receipt-time lower bound. ISO calendar timestamp with seconds, explicit timezone and at most three fractional digits; from <= to.",
        "schema": {
          "type": "string",
          "format": "date-time"
        }
      },
      "To": {
        "name": "to",
        "in": "query",
        "description": "Inclusive receipt-time upper bound. ISO calendar timestamp with seconds, explicit timezone and at most three fractional digits.",
        "schema": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid body, ID, query, date range, malformed URL encoding or malformed JSON (including corrupt compressed bodies).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Missing, malformed or incorrect application Bearer token.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "headers": {
          "WWW-Authenticate": {
            "schema": {
              "type": "string"
            },
            "description": "Bearer authentication challenge."
          }
        }
      },
      "NotFound": {
        "description": "Tracked cryptocurrency or route does not exist.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Conflict": {
        "description": "CoinMarketCap ID is already tracked or creation of that ID is in progress. A conflicting in-progress attempt may later fail; retry only after it finishes.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "PayloadTooLarge": {
        "description": "JSON body exceeds 16 KB.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "UnsupportedMediaType": {
        "description": "Request body must use application/json.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "UnknownAsset": {
        "description": "The requested CMC ID is absent from a successful provider response, or the provider explicitly reports no data for that single requested ID. Unrelated provider HTTP 400 responses remain upstream errors.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "InternalError": {
        "description": "Unexpected internal failure. No stack traces or secret details returned.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "UpstreamError": {
        "description": "External response or protocol failure.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Unavailable": {
        "description": "Provider access/rate limit prevents creation, no stored price is available, the service is stopping, or SQLite is temporarily busy (DATABASE_BUSY). A database lock returns immediately without waiting on the event loop.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "headers": {
          "Retry-After": {
            "description": "When present, minimum seconds before retrying. DATABASE_BUSY returns 1; provider cooldown may be longer.",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      },
      "UpstreamTimeout": {
        "description": "External request exceeded its bounded timeout.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  }
}
